# Environment Configuration for AI Negotiation System Backend

# LLM API Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-3.5-flash-lite

# Database Configuration
# Local SQLite (default for development):
DATABASE_URL=sqlite:///./negotiation.db

# Supabase PostgreSQL (Production / Remote DB):
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]
# Example:
# DATABASE_URL=postgresql://postgres.xxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Real SMTP Email Configuration (For real OTP Email delivery)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=NegoMind AI <noreply@negomind.ai>

# Real Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Real GitHub OAuth Credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
