# Environment Configuration for AI Negotiation System
# Copy this file to `.env` in root (for Vite Frontend) or in `backend/.env` (for FastAPI Backend)

# Backend LLM API Configuration
# Options for LLM_PROVIDER: "gemini", "openai", or "mock"
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.6-flash

# Backend Database & Server Configuration
DATABASE_URL=sqlite:///./negotiation.db
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend Configuration (Vite environment variables if needed)
VITE_API_BASE_URL=http://localhost:8000

